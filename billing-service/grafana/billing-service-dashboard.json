{
  "title": "Billing Service Dashboard",
  "uid": "billing-service",
  "version": 1,
  "schemaVersion": 36,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Payment Success Rate",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 4 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{app=\"billing-service\", uri=~\"/api/transactions.*\", status=\"200\"}[5m])) / sum(rate(http_server_requests_seconds_count{app=\"billing-service\", uri=~\"/api/transactions.*\"}[5m])) * 100",
          "legendFormat": "Success Rate %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 95 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Payment Events Published (per minute)",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 4 },
      "targets": [
        {
          "expr": "rate(spring_rabbitmq_template_published_total{app=\"billing-service\", exchange=\"payment.events\"}[1m]) * 60",
          "legendFormat": "{{ routing_key }}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "id": 3,
      "title": "DLQ Message Depth (payment.saga-listener.dlq)",
      "type": "stat",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 4 },
      "targets": [
        {
          "expr": "rabbitmq_queue_messages{queue=\"payment.saga-listener.dlq\"}",
          "legendFormat": "DLQ Depth"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Transaction Endpoint Latency (p95)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{app=\"billing-service\", uri=~\"/api/transactions.*\"}[5m])) by (le, uri))",
          "legendFormat": "p95 {{ uri }}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "id": 5,
      "title": "Active Transactions (PENDING)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 4, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "sum(billing_transactions_pending_total{app=\"billing-service\"})",
          "legendFormat": "Pending Transactions"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "id": 6,
      "title": "JVM Memory Usage",
      "type": "timeseries",
      "gridPos": { "x": 18, "y": 4, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{app=\"billing-service\", area=\"heap\"}",
          "legendFormat": "Heap Used"
        },
        {
          "expr": "jvm_memory_max_bytes{app=\"billing-service\", area=\"heap\"}",
          "legendFormat": "Heap Max"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "query": "label_values(up{app=\"billing-service\"}, instance)",
        "label": "Instance"
      }
    ]
  }
}