{
  "title": "Product Service Dashboard",
  "uid": "product-service-dashboard",
  "schemaVersion": 36,
  "version": 1,
  "tags": [
    "product-service",
    "amazon"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Error Rate \u2014 Errors per Minute (LogQL)",
      "description": "Counts ERROR-level log lines from product-service per minute. Spikes correlate with Elasticsearch/Neo4j failures, invalid product writes, or Feign call timeouts to order-service.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({agent=\"loki4j\"} |~ \"(?i)(error|warn|exception|failed)\" [5m]))",
          "legendFormat": "WARN+ERROR/5m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 2,
      "title": "Cache Operation Logs \u2014 Hit / Miss Events (LogQL)",
      "description": "Streams product-service log lines mentioning cache operations (Redis). High miss volume on product detail lookups indicates the Redis cache is not warm \u2014 S2-F12 caching may not be effective.",
      "type": "logs",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{agent=\"loki4j\"}",
          "legendFormat": "{{level}}"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "showLabels": true,
        "wrapLogMessage": true
      }
    },
    {
      "id": 3,
      "title": "Correlation ID Trace \u2014 Cross-Service Request Chains (LogQL)",
      "description": "Streams product-service log lines carrying a correlationId. Useful for tracing a single user request through the product\u2192order Feign call chain for language preference enrichment.",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum by (level) (count_over_time({agent=\"loki4j\"} |~ \"(?i)(cache|redis|evict|miss|hit|product)\" [5m]))",
          "legendFormat": "{{level}}"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "showLabels": true,
        "wrapLogMessage": true
      }
    },
    {
      "id": 4,
      "title": "HTTP Request Rate \u2014 Requests/s per Endpoint (PromQL)",
      "description": "Layer 1 \u2013 Metric: http_server_requests_seconds_count | Layer 2 \u2013 Label: job=product-service | Layer 3 \u2013 Range: [5m] | Layer 4 \u2013 Function: rate \u2192 sum by uri. Reveals which product endpoints (search, detail, sales) are under the most load during peak hours.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{job=\"product-service\"}[5m]))",
          "legendFormat": "{{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 5,
      "title": "HTTP Latency Percentiles \u2014 P50 / P95 / P99 (PromQL)",
      "description": "Layer 1 \u2013 Metric: http_server_requests_seconds_bucket | Layer 2 \u2013 Label: job=product-service | Layer 3 \u2013 Range: [5m] | Layer 4 \u2013 Function: histogram_quantile at 0.50, 0.95, 0.99. P99 latency on GET /api/products/{id}/sales identifies slow Feign enrichment from order-service.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"product-service\"}[5m])))",
          "legendFormat": "P50 {{uri}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"product-service\"}[5m])))",
          "legendFormat": "P95 {{uri}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"product-service\"}[5m])))",
          "legendFormat": "P99 {{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 6,
      "title": "Cache Hit / Miss Ratio \u2014 Redis Effectiveness (PromQL)",
      "description": "Layer 1 \u2013 Metric: cache_gets_total | Layer 2 \u2013 Label: job=product-service, result=hit|miss | Layer 3 \u2013 Range: [5m] | Layer 4 \u2013 Function: rate \u2192 sum by result. Verifies S2-F12 caching is effective \u2014 a falling hit ratio means products are not being cached or cache is being evicted prematurely.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(cache_gets_total{job=\"product-service\"}[5m]))",
          "legendFormat": "Cache {{result}}"
        },
        {
          "expr": "sum(rate(cache_gets_total{job=\"product-service\", result=\"hit\"}[5m])) / sum(rate(cache_gets_total{job=\"product-service\"}[5m]))",
          "legendFormat": "Hit Ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Hit Ratio"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          }
        ]
      }
    }
  ]
}